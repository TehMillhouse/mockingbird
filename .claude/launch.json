{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockingbird-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "mb", "serve", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "plots",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8010", "--directory", "models/plots"],
      "port": 8010
    }
  ]
}
